          "lyrics": [
            {
              "text": "If this is my last night with you",
              "markers": [
                {
                  "charIndex": 0,
                  "bar": 1,
                  "beat": 1
                }
              ]
            },
            {
              "text": "Hold me like I'm more than just a friend",
              "markers": [
