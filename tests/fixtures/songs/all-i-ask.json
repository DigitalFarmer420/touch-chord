                  "charIndex": 0,
                  "bar": 3,
                  "beat": 1
                }
              ]
            },
            {
              "text": "And I'm sure my eyes, they speak for me",
              "markers": [
                {
                  "charIndex": 0,
                  "bar": 4,
                  "beat": 1
                }
              ]
            },
            {
              "text": "No one knows me like you do",
              "markers": [
                {
                  "charIndex": 0,
                  "bar": 5,
                  "beat": 1
                }
              ]
            },
            {
              "text": "And since you're the only one that mattered",
