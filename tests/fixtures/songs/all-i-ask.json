          "lyrics": [
            {
              "text": "I will leave my heart at the door",
              "markers": [
                {
                  "charIndex": 0,
                  "bar": 1,
                  "beat": 1
                }
              ]
            },
            {
              "text": "I won't say a word",
              "markers": [
                {
                  "charIndex": 0,
                  "bar": 3,
                  "beat": 1
                }
              ]
            },
            {
              "text": "They've all been said before, you know",
              "markers": [
                {
                  "charIndex": 0,
                  "bar": 4,
                  "beat": 1
                }
              ]
            },
            {
              "text": "So why don't we just play pretend",
              "markers": [
                {
                  "charIndex": 0,
                  "bar": 5,
                  "beat": 1
                }
              ]
            },
            {
              "text": "Like we're not scared of what is coming next",
              "markers": [
                {
                  "charIndex": 0,
                  "bar": 7,
                  "beat": 1
                }
              ]
            },
            {
              "text": "Or scared of having nothing left",
              "markers": [
                {
                  "charIndex": 0,
                  "bar": 8,
                  "beat": 1
                }
              ]
            }
          ]
